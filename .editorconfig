root = true

[*.cs]
# Core formatting
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Coding conventions per AGENTS.md & Architecture
# Private fields: m_ prefix, camelCase
dotnet_naming_rule.private_fields_with_m.symbols = private_fields
dotnet_naming_rule.private_fields_with_m.style = prefix_m_camel_case
dotnet_naming_rule.private_fields_with_m.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, internal
dotnet_naming_style.prefix_m_camel_case.required_prefix = m_
dotnet_naming_style.prefix_m_camel_case.capitalization = camel_case

# Static private fields: s_ prefix, camelCase
dotnet_naming_rule.static_fields_with_s.symbols = static_private_fields
dotnet_naming_rule.static_fields_with_s.style = prefix_s_camel_case
dotnet_naming_rule.static_fields_with_s.severity = warning

dotnet_naming_symbols.static_private_fields.applicable_kinds = field
dotnet_naming_symbols.static_private_fields.required_modifiers = static
dotnet_naming_symbols.static_private_fields.applicable_accessibilities = private, internal
dotnet_naming_style.prefix_s_camel_case.required_prefix = s_
dotnet_naming_style.prefix_s_camel_case.capitalization = camel_case

# Event callbacks & emitter methods: Prefix On, PascalCase
dotnet_naming_rule.event_methods_with_on.symbols = event_symbols
dotnet_naming_rule.event_methods_with_on.style = prefix_on_pascal_case
dotnet_naming_rule.event_methods_with_on.severity = suggestion

dotnet_naming_symbols.event_symbols.applicable_kinds = event
dotnet_naming_symbols.event_symbols.applicable_accessibilities = *
dotnet_naming_style.prefix_on_pascal_case.required_prefix = On
dotnet_naming_style.prefix_on_pascal_case.capitalization = pascal_case

# Public members: PascalCase
dotnet_naming_rule.public_members_pascal.symbols = public_members
dotnet_naming_rule.public_members_pascal.style = pascal_case
dotnet_naming_rule.public_members_pascal.severity = warning

dotnet_naming_symbols.public_members.applicable_kinds = property, method, class, struct, enum, interface
dotnet_naming_symbols.public_members.applicable_accessibilities = public
dotnet_naming_style.pascal_case.capitalization = pascal_case

# Roslyn compiler severity rules for -warnaserror
dotnet_diagnostic.CS0168.severity = error # Variable declared but never used
dotnet_diagnostic.CS0219.severity = error # Variable assigned but never used
dotnet_diagnostic.CS0414.severity = error # Field assigned but never used
dotnet_diagnostic.CS0649.severity = suggestion # Field is never assigned to (Unity Inspector serialization)
dotnet_diagnostic.CS8032.severity = none
